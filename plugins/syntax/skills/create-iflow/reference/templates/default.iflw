                        </ifl:property>
                    </bpmn2:extensionElements>
                </bpmn2:errorEventDefinition>
            </bpmn2:endEvent>
            <bpmn2:sequenceFlow id="SequenceFlow_Err_1" sourceRef="StartEvent_Err" targetRef="CallActivity_Err_Header"/>
