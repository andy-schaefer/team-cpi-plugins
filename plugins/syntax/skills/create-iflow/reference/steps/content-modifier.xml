<!-- Content Modifier (Enricher). Set properties and/or headers.
     headerTable / propertyTable are ESCAPED XML grids of <row><cell id='...'>...</cell></row>.
     cell ids: Action(Create|Delete) Type(constant|expression|xpath|header|property) Value Default Name Datatype
     For an XPath property, Type=xpath, Value={{XPath_param}} or literal xpath, Datatype=java.lang.String.
     Put the body as constant (bodyType=constant, wrapContent empty) to leave payload untouched. -->
<bpmn2:callActivity id="@@ID@@" name="@@NAME@@">
    <bpmn2:extensionElements>
        <ifl:property><key>bodyType</key><value>constant</value></ifl:property>
        <ifl:property><key>propertyTable</key><value>@@PROPERTY_TABLE@@</value></ifl:property>
        <ifl:property><key>headerTable</key><value>@@HEADER_TABLE@@</value></ifl:property>
        <ifl:property><key>wrapContent</key><value/></ifl:property>
        <ifl:property><key>componentVersion</key><value>1.6</value></ifl:property>
        <ifl:property><key>activityType</key><value>Enricher</value></ifl:property>
        <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::Enricher/version::1.6.0</value></ifl:property>
    </bpmn2:extensionElements>
    <bpmn2:incoming>@@IN@@</bpmn2:incoming>
    <bpmn2:outgoing>@@OUT@@</bpmn2:outgoing>
</bpmn2:callActivity>

<!-- Example property row (one property SAP_ApplicationId via XPath param):
&lt;row>&lt;cell id='Action'>Create&lt;/cell>&lt;cell id='Type'>xpath&lt;/cell>&lt;cell id='Value'>{{SAP_ApplicationId_XPath}}&lt;/cell>&lt;cell id='Default'>&lt;/cell>&lt;cell id='Name'>SAP_ApplicationId&lt;/cell>&lt;cell id='Datatype'>java.lang.String&lt;/cell>&lt;/row>
     Example header row (constant):
&lt;row>&lt;cell id='Action'>Create&lt;/cell>&lt;cell id='Type'>constant&lt;/cell>&lt;cell id='Value'>{{sap-client}}&lt;/cell>&lt;cell id='Default'>&lt;/cell>&lt;cell id='Name'>sap-client&lt;/cell>&lt;cell id='Datatype'>&lt;/cell>&lt;/row>
-->
